@startuml 03_contenedores
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Container.puml
LAYOUT_TOP_DOWN()
hide stereotype
title Nivel 2 - Diagrama de Contenedores: PersonAPP (Docker Compose)

Person(operador, "Operador de consola", "Usa el menú interactivo.")
Person(cliente, "Cliente de la API", "Llama a la API REST.")

Boundary(sistema, "PersonAPP", "Sistema de software") {
  Container(api, "API REST", "Java 25 · Spring Boot 4.1.2", "Contenedor personapp-api (puerto 3000). Expone /api/v1 y Swagger UI.")
  Container(cli, "CLI", "Java 25 · Spring Boot 4.1.2", "Contenedor personapp-cli (perfil cli). Menú de consola interactivo.")
  ContainerDb(maria, "MariaDB", "MariaDB latest (puerto 3307)", "Base persona_db: tablas persona, profesion, telefono y estudios.")
  ContainerDb(mongo, "MongoDB", "MongoDB latest (puerto 27017)", "Base persona_db con autenticación en admin: colecciones persona, profesion, telefono y estudios.")
  Container(init, "mongo-init", "Shell + mongosh", "Servicio de un solo uso: crea el usuario y carga los datos de MongoDB.")
}

Rel(cliente, api, "Llama a /api/v1 y usa /swagger-ui", "HTTP, JSON")
Rel(operador, cli, "Opera el menú", "Consola")
Rel(api, maria, "Lee y escribe", "JDBC · mariadb:3306 (red de Compose)")
Rel(api, mongo, "Lee y escribe", "Mongo wire protocol · mongodb:27017")
Rel(cli, maria, "Lee y escribe", "JDBC")
Rel(cli, mongo, "Lee y escribe", "Mongo wire protocol")
Rel(init, mongo, "Ejecuta DDL (usuario) y DML (datos)", "mongosh")

SHOW_LEGEND()
@enduml
